  "spring_persistence": {
    "posting_unique_key": ["source", "external_posting_id"],
    "posting_fields": ["company_name", "job_title", "job_category", "source_url", "status", "content_status", "content_hash", "published_at", "updated_at", "expires_at", "collected_at", "last_seen_at"],
    "criterion_fields": ["criterion_type", "text", "source_quote"],
    "raw_text_persistence": false,
    "transaction_rules": [
      "UPDATED이면 공고를 upsert하고 기존 조건을 새 criteria로 한 트랜잭션에서 교체한다.",
      "UNCHANGED이면 조건을 교체하지 않고 last_seen_at과 공고 상태만 갱신한다.",
      "DB 커밋 성공 뒤 /internal/matching/postings/index를 호출한다.",
      "EXPIRED 또는 INACTIVE가 되면 같은 index API로 상태를 보내 Chroma 파생 인덱스에서 제거한다.",
      "AI 인덱싱 실패 시 DB 원본은 유지하고 재시도 가능한 동기화 실패로 기록한다."
    ]
  }
