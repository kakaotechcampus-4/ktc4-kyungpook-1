  },
  "spring_to_ai": {
    "method": "POST",
    "path": "/internal/job-postings/extract",
    "request": {
      "source": "COMPANY_CAREER_PAGE",
      "external_posting_id": "backend-101",
      "job_title": "백엔드 개발자",
      "source_url": "https://careers.example.com/jobs/backend-101",
      "raw_text": "담당 업무\nSpring Boot 기반 REST API를 설계하고 개발합니다.\n자격 요건\nJava 개발 경험이 필요합니다.",
      "previous_content_hash": null,
      "previous_content_status": "METADATA_ONLY"
    }
  },
  "ai_to_spring": {
    "data": {
      "source": "COMPANY_CAREER_PAGE",
      "external_posting_id": "backend-101",
      "source_url": "https://careers.example.com/jobs/backend-101",
      "content_hash": "d58672547fc7551543e342e9c71252041d7a03ab6371064c47287ca164ba2557",
      "outcome": "UPDATED",
      "content_status": "READY",
      "criteria": [
        {
          "criterion_type": "RESPONSIBILITY",
          "text": "Spring Boot 기반 REST API 개발",
