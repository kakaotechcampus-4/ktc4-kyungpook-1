# 운영 compose 환경변수. 서버에서 이 파일을 deploy/.env 로 복사해 값을 채운다.
# deploy/.env 는 .gitignore 대상이다 — 값을 이 example 파일이나 문서에 적지 않는다 (이 레포는 public).

# 공개 주소. 도메인이 없으면 EIP 로 sslip.io 를 쓴다: 43.203.1.2 → 43-203-1-2.sslip.io
# 로컬 확인은 localhost
SITE_ADDRESS=
# 주소를 바꿨다면 옛 주소를 적는다. 그 주소로 들어오면 SITE_ADDRESS 의 같은 경로로 넘긴다
LEGACY_SITE_ADDRESS=

# PostgreSQL 비밀번호. 생성: openssl rand -hex 24
DB_PASSWORD=

# GitHub OAuth App (Authorization callback URL = https://<SITE_ADDRESS>/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub 토큰 암호화 키·솔트. 한 번 정하면 바꾸지 않는다 — 바꾸면 저장된 토큰을 복호화할 수 없다.
# 생성: openssl rand -hex 32 (키), openssl rand -hex 8 (솔트, 16진수여야 한다)
TOKEN_ENC_KEY=
TOKEN_ENC_SALT=

# LLM 게이트웨이 (경험 그룹화·STAR 초안). 팀이 정한 운영 게이트웨이 주소와 키를 넣는다.
# 비워 두면 그 두 기능만 503 이고 수집·되묻기는 동작한다.
GITORY_LLM_BASE_URL=
GITORY_LLM_API_KEY=

# 분석 Job 에 경험 그룹화를 붙일지. 위 LLM 값을 넣고 AI 가 응답하는 걸 확인한 뒤 true 로 바꾼다.
ANALYSIS_GROUPING_ENABLED=false

# 분석 단계에 읽은 수/전체를 실시간으로 보여 줄지. 문제가 생기면 false 로 끄면 예전처럼 한 번에 받는다.
ANALYSIS_LIVE_PROGRESS_ENABLED=true

# 후보로 만든 카드에 AI STAR 초안을 채울지. 위 LLM 값을 넣고 AI 가 응답하는 걸 확인한 뒤 true 로 바꾼다.
CARD_AI_DRAFT_ENABLED=false

# STAR 초안에서 코드 검사(근거 없음·근거 없는 숫자)에 걸린 칸만 다시 쓰게 할지. 문제가 생기면 false 로 끈다.
GITORY_STAR_REPAIR_ENABLED=true
# 다시 쓰기 전에 LLM 으로 원문과 뜻이 뒤집힌 칸도 검토할지와 검토 모델(비우면 gpt-5.6-luna).
GITORY_STAR_REVIEW_ENABLED=false
GITORY_STAR_REVIEW_MODEL=

# 되묻기 질문·답 평가·카드 초안의 사용자별 호출 제한(429 RATE_LIMITED)을 켤지.
# 429 안내 문구를 보여주는 프론트(#335)가 배포된 뒤 true 로 바꾼다. redis 서비스는 이 값과 상관없이 뜬다.
RATE_LIMIT_ENABLED=false

# 매일 새벽 5시(서울)에 회사 채용 공고를 가져와 조건을 뽑고 AI 색인에 보낼지. 위 LLM 값을 넣은 뒤 true 로 바꾼다.
MATCHING_SYNC_ENABLED=false

# 공고 가져오기가 끝난 뒤 새로 올라온 공고 중 확정 카드와 잘 맞는 곳을 알림으로 남길지. 위 MATCHING_SYNC_ENABLED 가 켜져 있어야 돌며, 사용자마다 AI 판단을 공고 5건까지 부른다.
MATCHING_ALERT_ENABLED=false

# 인적사항에서 수신을 켠 사용자에게 확인 메일과 새 공고 메일을 보낼지. 아래 계정을 넣은 뒤 true 로 바꾼다.
# MAIL_USERNAME 은 보내는 Gmail 주소, MAIL_PASSWORD 는 Google 계정의 앱 비밀번호, GITORY_APP_BASE_URL 은 메일 안 링크의 앞부분(배포 주소)이다.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
GITORY_APP_BASE_URL=

# 홈 한 줄 명령(한 문장으로 맡기면 서버가 걸음마다 도구를 골라 실행)을 켤지. 화면의 VITE_ASSISTANT_ENABLED 와 함께 true 로 바꾼다.
ASSISTANT_ENABLED=false

# 배포 주소의 /api/swagger-ui.html 에서 API 문서를 열지. 문서만 보이고 API 호출에는 로그인이 필요하다.
API_DOCS_ENABLED=false
# 로켓펀치 Open API 키(developers.rocketpunch.com 콘솔에서 발급). 비워 두면 로켓펀치 공고만 건너뛴다.
ROCKETPUNCH_API_KEY=

# 서버나 AI 문제로 Job 이 실패하면 한 줄을 보낼 Discord 웹훅 주소. 비워 두면 알리지 않는다.
GITORY_ALERT_WEBHOOK_URL=
