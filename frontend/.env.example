# ── 개발 ──────────────────────────────────────────────────────────────
# true  : Vite 미들웨어 목 API (백엔드 없이 전 화면 동작)
# false : /api 를 VITE_API_ORIGIN(Spring) 으로 프록시
VITE_API_MOCK=true
VITE_API_ORIGIN=http://localhost:8080

# ── 배포 ──────────────────────────────────────────────────────────────
# 프론트가 부르는 API 접두사. 같은 오리진 뒤에 /api 를 리버스 프록시로 붙이는 게 기본 (R-10 교차 출처 쿠키 회피).
# API 가 다른 오리진이면 절대 URL 을 넣고, 서버는 SameSite=None; Secure 쿠키 + CORS allow-credentials 를 줘야 한다.
# VITE_API_BASE=/api
